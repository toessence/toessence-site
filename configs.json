{
  "version": "1.0.0",
  "updated": "2026-05-22",
  "hoverDelay": 1000,
  "sites": [
    {
      "domain": "youtube.com",
      "type": "video",
      "trigger": "#video-title, a#video-title-link, yt-formatted-string#video-title, h3 a",
      "card": "ytd-rich-item-renderer, ytd-video-renderer, ytd-compact-video-renderer, ytd-grid-video-renderer",
      "fields": {
        "link": "a[href*=\"watch?v=\"]",
        "title": "#video-title, h3 a, h3"
      }
    },
    {
      "domain": "yakaboo.ua",
      "type": "book",
      "trigger": "a.category-card__name, .ui-card-title a, a.product-link",
      "card": ".category-card, .product-card",
      "fields": {
        "title": ".category-card__name, .ui-card-title",
        "price": ".category-card__price, .product-price",
        "shortDesc": ".product-description, .category-card__desc"
      }
    },
    {
      "domain": "book-ye.com.ua",
      "type": "book",
      "trigger": "a.product-item-link, a.product-item-name",
      "card": ".product-item-info, .product-item",
      "fields": {
        "title": ".product-item-name, .product-item-link",
        "shortDesc": ".product-item-description"
      }
    },
    {
      "domain": "book.ua",
      "type": "book",
      "trigger": "a.product-tile__title",
      "card": ".product-tile, .slider-tiles__item",
      "fields": {
        "title": "a.product-tile__title",
        "shortDesc": ".product-tile__description"
      }
    },
    {
      "domain": "bookclub.ua",
      "type": "book",
      "trigger": "a.ui-catalog-card",
      "card": ".ui-catalog-card",
      "fields": {
        "titleAttr": "aria-label",
        "title": ".ui-catalog-card__title, [aria-label]"
      }
    },
    {
      "domain": "bookopt.com.ua",
      "type": "book",
      "trigger": "a.product-list-name",
      "card": ".product_item",
      "fields": {
        "title": "a.product-list-name",
        "shortDesc": ".product-list-description"
      }
    }
  ],
  "newsDefault": {
    "type": "news",
    "note": "Усі інші сайти обробляються як news через універсальний детектор заголовків"
  }
}
